{
  "name": "janganlupa",
  "version": "1.0.0",
  "description": "Simpan link dari mana saja, tulis konteksnya, temukan lagi, dan bagikan ke email teman seperti di Drive. React + Hono di Cloudflare Workers + D1, muat di free tier.",
  "license": "MIT",
  "author": "rizalahmaddd",
  "homepage": "https://janganlupa.solusikoding.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rizalahmaddd/janganlupa.git"
  },
  "bugs": {
    "url": "https://github.com/rizalahmaddd/janganlupa/issues"
  },
  "keywords": [
    "bookmark-manager",
    "read-later",
    "link-manager",
    "cloudflare-workers",
    "cloudflare-d1",
    "hono",
    "react",
    "pwa",
    "magic-link",
    "indonesia"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 migrations apply janganlupa --local",
    "db:migrate:remote": "wrangler d1 migrations apply janganlupa --remote",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "test:e2e": "python3 -I tests/api_e2e.py"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.153.0"
  }
}
